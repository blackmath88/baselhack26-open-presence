{
  "name": "br-ai-nstorm",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/http/server.ts",
    "dev:cloudflare": "npm run build && npx wrangler@latest dev",
    "mcp": "tsx server/mcp/stdio.ts",
    "commons": "tsx scripts/commons/cli.ts",
    "pds:dev": "node tools/local-pds/start.mjs",
    "test:atproto": "vitest run server/test/atproto",
    "brainstorm": "tsx scripts/brainstorm.ts",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && npx wrangler@latest deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "index:check": "node scripts/corpus/check-index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.worker.json",
    "typecheck:e": "tsc --noEmit --jsx react-jsx --moduleResolution bundler --module esnext --target es2022 --skipLibCheck --esModuleInterop e-preview/main.tsx",
    "build:e": "npm run typecheck:e && vite build --config vite.e-preview.config.ts",
    "preview:e": "vite preview --config vite.e-preview.config.ts",
    "test:e": "vitest run test/e-guide.test.ts test/e-behaviour.test.ts test/e-opening.test.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.30.0",
    "@atproto/common-web": "^0.5.15",
    "@atproto/identity": "^0.5.20",
    "@atproto/lexicon": "^0.7.17",
    "@atproto/syntax": "^0.7.7",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "d3": "^7.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
